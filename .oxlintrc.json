{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc"],
  "rules": {
    "complexity": ["warn", 20],
    "max-depth": ["warn", 4],
    "max-lines": [
      "warn",
      {
        "max": 500,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "warn",
      {
        "max": 100,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-params": ["warn", 4],
    "no-var": "warn",
    "no-var-requires": "error"
  },
  "overrides": [
    {
      "files": [
        "scripts/electron-active-hook*.cjs",
        "tests/conformance/readiness/electron/*.js"
      ],
      "rules": {
        "no-var-requires": "off"
      }
    },
    {
      "files": [
        "src/{contracts,domain,server}/**/*.ts",
        "src/application/**/*.ts"
      ],
      "excludeFiles": ["src/application/runtime.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/ghidra/**",
                  "**/hopper/**",
                  "**/ida/**",
                  "**/android/**",
                  "**/firmware/**",
                  "**/browser/*Provider.*"
                ],
                "message": "Provider imports belong behind typed ports or in production composition."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/{contracts,domain}/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/application/**",
                  "**/server/**",
                  "**/cli/**",
                  "**/main/**",
                  "**/cli.*",
                  "**/main.*",
                  "**/android/**",
                  "**/artifacts/**",
                  "**/browser/**",
                  "**/dotnet/**",
                  "**/firmware/**",
                  "**/ghidra/**",
                  "**/hopper/**",
                  "**/ida/**",
                  "**/native/**",
                  "**/process/**",
                  "**/reference/**",
                  "**/windows/**",
                  "**/composition/**"
                ],
                "message": "Domain and contracts depend inward; use typed ports for application, caller and provider boundaries."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/application/**/*.ts"],
      "excludeFiles": ["src/application/runtime.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/ghidra/**",
                  "**/hopper/**",
                  "**/ida/**",
                  "**/android/**",
                  "**/firmware/**",
                  "**/browser/*Provider.*",
                  "**/composition/**"
                ],
                "message": "Application workflows use typed ports; production construction belongs in composition."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tests/**/*.ts", "src/**/*.test.ts", "src/**/*.fixture.ts"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": [
          "error",
          {
            "max": 150,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": ["src/domain/**/*.{fixture,test}.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/application/**",
                  "**/server/**",
                  "**/process/**",
                  "**/browser/**",
                  "**/ghidra/**",
                  "**/hopper/**",
                  "**/ida/**",
                  "**/replay/**",
                  "**/cli.*",
                  "**/main.*",
                  "**/composition/**",
                  "**/android/**",
                  "**/firmware/**"
                ],
                "message": "Domain tests may import only their owning domain and inward dependencies."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/application/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/server/**", "**/cli.*", "**/main.*"],
                "message": "Service tests must use application ports rather than CLI or MCP entrypoints."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tests/composition/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/server/**",
                  "**/cli.*",
                  "**/main.*",
                  "node:child_process",
                  "node:net",
                  "node:http",
                  "node:https",
                  "ws",
                  "playwright"
                ],
                "message": "Composition tests may wire provider-neutral sessions but must not invoke CLI, MCP, process, network, or browser boundaries."
              }
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "node": true,
    "es2023": true
  },
  "ignorePatterns": [
    "dist",
    "build",
    "node_modules",
    "docs/api",
    "coverage",
    ".turbo",
    ".cache",
    ".codex",
    ".devin",
    ".factory",
    "third_party"
  ]
}
