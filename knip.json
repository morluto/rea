{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/main.ts",
    "src/cli.ts",
    "src/cliOutput.ts",
    "src/cliBuiltinArguments.ts",
    "src/cli/cliResultOutput.ts",
    "src/mcpDoctor.ts",
    "src/composition/javascriptAnalysisWorkerProcess.ts",
    "src/composition/webBundleAnalysisWorkerProcess.ts",
    "src/contracts/errorSchemas.ts",
    "scripts/verify/fridaBindingsCompatibility.ts",
    "scripts/verify/termux/browser.mjs",
    "scripts/verify-real-ghidra-noreturn.mjs",
    "scripts/verify-real-ghidra-decompiler-failure.mjs",
    "scripts/verify-real-ghidra-decompile-timeout.mjs",
    "scripts/verify-real-ghidra-psp-indirect.mjs",
    "tests/processOwnershipRunner.ts"
  ],
  "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs"],
  "vitepress": {
    "entry": ["docs/.vitepress/config.ts"]
  },
  "ignoreBinaries": ["^g\\+\\+$", "mkfifo"],
  "ignoreDependencies": [
    "@stryker-mutator/command-runner",
    "electron",
    "esbuild",
    "webpack"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "duplicates": "error"
  }
}
