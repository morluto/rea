#. {ph4}: <mark class="prose-highlight">
#. {ph5}: </mark>
#: website/public/index.html:312
#, python-brace-format
msgctxt "page:index.html"
msgid ""
"The goal: understand a feature well enough to {ph0}explain it{ph1}, "
"{ph2}change it{ph3} or {ph4}rebuild it.{ph5}"
msgstr ""
"الهدف: فهم ميزة جيدا بما فيه الكفاية ل {ph0}اشرح ذلك{ph1}, {ph2}تغيير "
"ذلك{ph3} أو {ph4}إعادة بنائه.{ph5}"

