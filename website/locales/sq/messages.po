msgstr ""
"{ph0}Konfigurimi i klientit dhe zgjidhja e problemeve{ph1} · {ph2}Lësho "
"disponueshmërinë{ph3}"

#: website/public/get-started/index.html:773
msgctxt "page:get-started/index.html"
msgid "Grok Bot · connect on its hosted computer"
msgstr "Grok Bot · lidheni në kompjuterin e tij pritës"

#. {ph0}: <code>rea</code>
#: website/public/get-started/index.html:774
#, python-brace-format
msgctxt "page:get-started/index.html"
msgid ""
"In Grok Bot's chat, ask it to add a custom MCP server named {ph0} using this"
" command on the Bot's computer:"
msgstr ""
"Në bisedën e Grok Bot, kërkoni që të shtojë një server të personalizuar MCP "
"me emrin {ph0} duke përdorur këtë komandë në kompjuterin e Bot:"

