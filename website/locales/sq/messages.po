#, python-brace-format
msgctxt "page:get-started/index.html"
msgid ""
"Run {ph0} in your working folder. Use {ph1} in its chat to connect your "
"model account, then select a model."
msgstr ""
"Ekzekutoni {ph0} në dosjen tuaj të punës. Përdorni {ph1} në bisedën e tij "
"për të lidhur llogarinë tuaj të modelit, më pas zgjidhni një model."

#. {ph0}: <a href="https://opencode.ai/docs/" >
#. {ph1}: </a >
#: website/public/get-started/index.html:631
#, python-brace-format
msgctxt "page:get-started/index.html"
msgid "{ph0}OpenCode installation and model setup{ph1}"
msgstr "{ph0}Instalimi i OpenCode dhe konfigurimi i modelit{ph1}"

