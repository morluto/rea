#: website/public/get-started/index.html:1017
msgctxt "page:get-started/index.html"
msgid "Analyze another kind of software"
msgstr "Analizoni një lloj tjetër softueri"

#: website/public/get-started/index.html:1018
msgctxt "page:get-started/index.html"
msgid ""
"Choose the section for your target. A provider is the local analysis tool "
"REA uses for that kind of software."
msgstr ""
"Zgjidhni seksionin për objektivin tuaj. Një ofrues është mjeti lokal i "
"analizës që përdor REA për atë lloj softueri."

#: website/public/get-started/index.html:1023
msgctxt "page:get-started/index.html"
msgid "Native executables and libraries · Hopper, Ghidra or IDA"
msgstr "Ekzekutuesit dhe bibliotekat native · Hopper, Ghidra ose IDA"

