msgctxt "page:first-investigation/index.html"
msgid ""
"{ph0}Bridge · {ph1}{ph2}{ph3}{ph4}{ph5}{ph6}Sends a named message to the "
"main process.{ph7}"
msgstr ""
"{ph0}Ura · {ph1}{ph2}{ph3}{ph4}{ph5}{ph6}Dërgon një mesazh me emër te "
"procesi kryesor.{ph7}"

