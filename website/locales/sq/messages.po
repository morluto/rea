"{ph0}Adresa:{ph1} një vendndodhje në program, e shkruar në heksadecimal, si "
"p.sh. {ph2}."

#. {ph0}: <strong>
#. {ph1}: </strong>
#: website/public/guides/native/index.html:257
#, python-brace-format
msgctxt "page:guides/native/index.html"
msgid ""
"{ph0}Constants:{ph1} fixed numbers stored in the program, read as raw bytes "
"and decoded."
msgstr ""
"{ph0}Konstantet:{ph1} numra fiks të ruajtur në program, të lexuar si bajt të"
" papërpunuar dhe të deshifruar."

