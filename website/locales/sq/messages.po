#, python-brace-format
msgctxt "page:get-started/index.html"
msgid ""
"{ph0}Download Claude Desktop{ph1} · {ph2}Claude Desktop connection "
"details{ph3}"
msgstr ""
"{ph0}Shkarko Claude Desktop{ph1} · {ph2}Detajet e lidhjes Claude "
"Desktop{ph3}"

#: website/public/get-started/index.html:611
msgctxt "page:get-started/index.html"
msgid "OpenCode · choose an AI model"
msgstr "OpenCode · zgjidhni një model AI"

#. {ph0}: <code>opencode</code>
#. {ph1}: <code>/connect</code>
