msgstr "{ph0} · rreshtat 8–12"

#: website/public/first-investigation/index.html:383
msgctxt "page:first-investigation/index.html"
msgid "Source"
msgstr "Burimi"

#: website/public/first-investigation/index.html:391
msgctxt "page:first-investigation/index.html"
msgid ""
"The file path, formatter and write call are together in this handler. Ask "
"your agent to show these lines if its answer leaves them out."
msgstr ""
"Shtegu i skedarit, formatuesi dhe thirrja e shkrimit gjenden së bashku në "
"këtë trajtues. Kërkojini agjentit tuaj t’i tregojë këto rreshta nëse i ka "
"lënë jashtë përgjigjes."

