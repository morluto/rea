msgstr ""
"{ph0}Shiko gjurmimin e plotë të kodit dhe rezultatin e regjistruar REA{ph1}."

#: website/public/first-investigation/index.html:403
msgctxt "page:first-investigation/index.html"
msgid "4. Check a prediction"
msgstr "4. Kontrolloni një parashikim"

#: website/public/first-investigation/index.html:404
msgctxt "page:first-investigation/index.html"
msgid ""
"A comma separates CSV columns. What happens when a note title itself "
"contains a comma or quotation marks?"
msgstr ""
"Një presje ndan kolonat CSV. Çfarë ndodh kur vetë titulli i shënimit përmban"
" një presje ose thonjëza?"

