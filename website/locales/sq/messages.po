#: website/public/showcase/th04/index.html:6
msgctxt "page:showcase/th04/index.html"
msgid "TH04 Reverse Engineering: DOS Bullet Patterns — REA"
msgstr "Inxhinieria e kundërt e TH04: Modelet e plumbave në DOS — REA"

#: website/public/showcase/th04/index.html:7
msgctxt "page:showcase/th04/index.html"
msgid ""
"Inspect TH04's original 16-bit DOS code with REA. Follow the assembly and "
"recovered C++ to see how a ring of bullets is spaced and aimed at the "
"player."
msgstr ""
"Inspektoni kodin origjinal DOS 16-bit të TH04 me REA. Ndiqni kodin assembly "
"dhe C++ të rikuperuar për të parë se si një unazë plumbash shpërndahet dhe "
"drejtohet drejt lojtarit."

