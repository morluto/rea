msgid "{ph0}{ph1}{ph2}{ph3}{ph4}{ph5}{ph6}{ph7}Your coding agent"
msgstr "{ph0}{ph1}{ph2}{ph3}{ph4}{ph5}{ph6}{ph7}আপনার coding agent"

#: website/public/guides/rl-environments/index.html:304
#: website/public/guides/rl-environments/index.html:349
#: website/public/guides/rl-environments/index.html:384
#: website/public/guides/rl-environments/index.html:421
msgctxt "page:guides/rl-environments/index.html"
msgid "Copy"
msgstr "কপি"

#. {ph0}: <span class="prompt-symbol" aria-hidden="true">
#. {ph1}: </span >
#. {ph2}: <span id="environment-prompt" >
#. {ph3}: <code>http://127.0.0.1:3000</code>
#. {ph4}: <code>APP_PASSWORD</code>
