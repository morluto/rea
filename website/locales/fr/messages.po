msgid "Download the complete solver"
msgstr "Télécharger le solveur complet"

#: website/public/showcase/ctf/index.html:627
msgctxt "page:showcase/ctf/index.html"
msgid "Check the answer with the original program"
msgstr "Vérifiez la réponse avec le programme d'origine"

